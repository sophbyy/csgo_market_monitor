# Steam Web API Key (REQUIRED)
# Get yours from: https://steamcommunity.com/dev
STEAM_API_KEY=your_steam_api_key_here

# Steam Inventory Helper extension path (OPTIONAL)
# Absolute path to the unpacked SIH Chrome extension directory.
# Leave commented out to run without SIH (inventory value uses API fallback).
# SIH_EXTENSION_PATH=/path/to/steam-inventory-helper
